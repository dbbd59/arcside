{
  "manifest_version": 3,
  "name": "Arcside",
  "version": "0.0.2",
  "description": "Arc-style vertical sidebar for tabs, favorites and workspaces.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "tabs", "bookmarks", "storage", "favicon", "offscreen", "clipboardWrite", "alarms", "sessions", "scripting", "search", "downloads"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Open Arcside" },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+D", "mac": "Command+Shift+D" },
      "description": "Open Arcside"
    },
    "open-palette": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Jump to a tab or saved link (in-page palette)"
    },
    "copy-url": {
      "suggested_key": { "default": "Ctrl+Shift+C", "mac": "Command+Shift+C" },
      "description": "Copy the active tab link"
    }
  },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["ambient-probe.js"], "run_at": "document_idle" }],
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "web_accessible_resources": [{ "resources": ["_favicon/*"], "matches": ["<all_urls>"], "extension_ids": ["*"] }],
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": {
    "16": "icons/arcside16.png",
    "32": "icons/arcside32.png",
    "48": "icons/arcside48.png",
    "128": "icons/arcside128.png"
  }
}
